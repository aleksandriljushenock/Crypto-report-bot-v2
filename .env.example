# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase. Prefer the service-role key for server-side learning writes.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_MODEL_BUCKET=models

# AI and market data
OPENAI_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# Multi-exchange scanner
ENABLED_EXCHANGES=binance,mexc,bybit,okx,kucoin,gate,bitget
EXCHANGE_QUOTES=USDT,USDC
EXCHANGE_HTTP_TIMEOUT=20
EXCHANGE_HTTP_RETRIES=4

# Cloud runtime
DATA_DIR=/app/data
LOG_DIR=/app/logs
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
TZ=Europe/Moscow
