# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase. Prefer the service-role key for server-side learning writes.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_MODEL_BUCKET=models

# AI and market data
OPENAI_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# Multi-exchange scanner
ENABLED_EXCHANGES=binance,mexc,bybit,okx,kucoin,gate,bitget
EXCHANGE_QUOTES=USDT,USDC
EXCHANGE_HTTP_TIMEOUT=20
EXCHANGE_HTTP_RETRIES=4

# Cloud runtime
DATA_DIR=/app/data
LOG_DIR=/app/logs
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
TZ=Europe/Moscow

# Render webhook runtime
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
DROP_PENDING_UPDATES=false

SMART_MONEY_EXCHANGES=bybit,okx,binance
BYBIT_API=https://api.bybit.com
OKX_API=https://www.okx.com

# Trading scanner market source. Bybit is recommended on Render because
# Binance often blocks Render IP ranges with HTTP 418.
# Legacy single-provider mode (leave unset for fallback):
# TRADE_MARKET_PROVIDER=bybit
BYBIT_API_BASE=https://api.bybit.com

# Binance-first market synchronization with automatic fallback.
TRADE_MARKET_PROVIDERS=binance,bybit
EXCHANGE_PROVIDER_COOLDOWN_SECONDS=900
BYBIT_API_BASE=https://api.bybit.com
EXCHANGE_HTTP_TIMEOUT=15

# Restore Trade Monitor automatically after Render restarts.
MONITOR_AUTO_ENABLE=true

# Runtime self-healing
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_INTERVAL_SECONDS=120
TRADE_MONITOR_STALE_SECONDS=1500
HEALTH_RESTART_COOLDOWN_SECONDS=120

# Adaptive quality learning from Supabase outcomes
ADAPTIVE_CLOUD_MIN_SAMPLES=20
ADAPTIVE_CLOUD_MAX_ROWS=1000
ADAPTIVE_WEIGHT_MAX_STEP=0.12
ADAPTIVE_WEIGHT_LEARNING_RATE=0.35

# Render keep-alive (best effort on free plan)
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_SECONDS=600
KEEPALIVE_INITIAL_DELAY_SECONDS=60
# Optional explicit endpoint; by default PUBLIC_BASE_URL/RENDER_EXTERNAL_URL + /wake
# KEEPALIVE_URL=https://crypto-report-bot.onrender.com/wake

# Persistent v14 learning and low-memory Render profile
LEARNING_CLOUD_RESTORE_ENABLED=true
LEARNING_CLOUD_MAX_ROWS=3000
LEARNING_SEARCH_ITERATIONS=100
TRADE_SCAN_MAX_WORKERS=2
TRADE_TOP_LIQUID_SYMBOLS=24
TRADE_LISTING_PRIORITY_LIMIT=12
TRADE_DISCOVERY_PRIORITY_LIMIT=10
MEMORY_SOFT_LIMIT_MB=430

# Learning quality upgrade
LEARNING_MIN_SAMPLES=200
LEARNING_SPECIALIST_MIN_SAMPLES=80
LEARNING_MIN_HOLDOUT_SAMPLES=40
LEARNING_DEDUPE_WINDOW_MINUTES=20
LEARNING_SIGNAL_DEDUPE_MINUTES=20
LEARNING_COLLECTION_SAVE_STEP=25
LEARNING_WALK_FORWARD_FOLDS=4
LEARNING_SEARCH_ITERATIONS=240

# Chronos-Bolt zero-shot expert — memory-safe final-candidate mode
CHRONOS_ENABLED=true
CHRONOS_MODE=local
CHRONOS_MODEL=amazon/chronos-bolt-tiny
CHRONOS_TIMEFRAME=15m
CHRONOS_MIN_CONTEXT=64
CHRONOS_CONTEXT_LENGTH=128
CHRONOS_PREDICTION_LENGTH=8
CHRONOS_MAX_WEIGHT=0.18
CHRONOS_FINALISTS=1
CHRONOS_UNLOAD_AFTER_BATCH=true
CHRONOS_MEMORY_GUARD_ENABLED=true
CHRONOS_REQUIRED_HEADROOM_MB=230
CHRONOS_TORCH_DTYPE=float32
# Optional external inference service; use CHRONOS_MODE=remote when configured.
CHRONOS_REMOTE_URL=
CHRONOS_REMOTE_TOKEN=
CHRONOS_REMOTE_TIMEOUT_SECONDS=45
HF_HOME=/tmp/huggingface
MEMORY_SOFT_LIMIT_MB=390
MEMORY_HARD_LIMIT_MB=500

# Persistent checkpoint of local v14 learning state in Supabase Storage
LEARNING_CHECKPOINT_ENABLED=true
LEARNING_CHECKPOINT_INTERVAL_MINUTES=10
LEARNING_CHECKPOINT_BUCKET=learning-checkpoints
LEARNING_CHECKPOINT_PATH=v14/latest/learning_v14.db
LEARNING_CHECKPOINT_META_PATH=v14/latest/metadata.json
LEARNING_CHECKPOINT_LOCAL_BACKUPS=3

# Durable cloud-first learning synchronization
LEARNING_READY_HORIZON=1h
LEARNING_CLOUD_MAX_ROWS=3000
LEARNING_OUTCOMES_CHECKPOINT_PATH=v14/latest/trade_outcomes.db
TRADE_OUTCOMES_DB_PATH=data/trade_outcomes.db

# Profit-oriented signal quality gate (based on 1,144 resolved LONG signals)
QUALITY_GATE_ENABLED=true
QUALITY_MIN_SCORE=72
QUALITY_MIN_QUOTE_VOLUME=130000000
QUALITY_MIN_RR=2.3
QUALITY_MAX_ADJUSTMENT=25

# AI Hedge Fund / EV-oriented signal gate
HEDGE_QUALITY_GATE_ENABLED=true
HEDGE_MIN_QUALITY=70
HEDGE_MIN_EV_PCT=0.20
HEDGE_MAX_RULE_ADJUSTMENT=24
HEDGE_CANDIDATE_POOL=20
HEDGE_DEFAULT_RISK_PCT=1.0
PROFIT_PROFILE_PATH=data/profit_profile_v2.json

# 512 MB Render memory-safe profile
LOW_MEMORY_MODE=true
WEB_CONCURRENCY=1
GUNICORN_WORKERS=1
GUNICORN_THREADS=1
TRADE_SCAN_MAX_WORKERS=1
TRADE_TOP_LIQUID_SYMBOLS=16
HEDGE_CANDIDATE_POOL=10
LEARNING_CLOUD_MAX_ROWS=750
LEARNING_SEARCH_ITERATIONS=40
MEMORY_SOFT_LIMIT_MB=340
MEMORY_HARD_LIMIT_MB=470
CHRONOS_ENABLED=true
CHRONOS_MODE=subprocess
CHRONOS_FINALISTS=1
CHRONOS_CONTEXT_LENGTH=96
CHRONOS_PREDICTION_LENGTH=6
CHRONOS_TORCH_THREADS=1
CHRONOS_REQUIRED_HEADROOM_MB=220
CHRONOS_SUBPROCESS_TIMEOUT_SECONDS=150
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# News: collect for AI calculations, but show only on explicit Telegram button /news.
NEWS_ENGINE_ENABLED=true
NEWS_AUTO_NOTIFICATIONS=false
NEWS_NOTIFY_MIN_IMPACT=75
