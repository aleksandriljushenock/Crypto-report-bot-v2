FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    DATA_DIR=/app/data \
    LOG_DIR=/app/logs \
    TZ=Europe/Minsk

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gosu tini ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system bot \
    && useradd --system --gid bot --create-home bot

COPY requirements.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.txt

COPY . .

RUN mkdir -p /app/data /app/logs \
    && chown -R bot:bot /app

USER root

COPY docker-entrypoint-v44.sh /usr/local/bin/docker-entrypoint-v44
RUN chmod +x /usr/local/bin/docker-entrypoint-v44
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-v44"]
CMD ["python", "cloud_entrypoint.py"]
